<Window x:Class="ActEditor.Tools.PaletteEditorTool.Bgra32EditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:genericControls="clr-namespace:ActEditor.Core.WPF.GenericControls"
        Title="BGRA32 editor" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource TabItemBackground}"
        Foreground="{StaticResource TextForeground}">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="110" />
			<ColumnDefinition Width="260" />
			<ColumnDefinition Width="60" />
		</Grid.ColumnDefinitions>

		<CheckBox Grid.Row="0" Grid.ColumnSpan="3" x:Name="_cbSelectedOnly" Margin="0 0 0 10"
		          Content="Selected layers only" Checked="_control_ValueChanged" Unchecked="_control_ValueChanged" />

		<CheckBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="_cbTargetColor" Margin="0 0 0 6"
		          Content="Limit adjustments to target color" Checked="_control_ValueChanged" Unchecked="_control_ValueChanged" />

		<Label Grid.Row="2" Grid.Column="0" Content="Target color" Padding="0" VerticalAlignment="Center" />
		<genericControls:QuickColorSelector Grid.Row="2" Grid.Column="1" x:Name="_targetColor" Height="22" Width="90"
		                                    HorizontalAlignment="Left" ColorChanged="_targetColor_ColorChanged" />

		<Label Grid.Row="3" Grid.Column="0" Content="Hue tolerance" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="3" Grid.Column="1" x:Name="_sliderTolerance" Minimum="0" Maximum="90" TickFrequency="5" Value="45" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="3" Grid.Column="2" x:Name="_tbTolerance" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="4" Grid.Column="0" Content="Min. saturation" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="4" Grid.Column="1" x:Name="_sliderMinimumSaturation" Minimum="0" Maximum="100" TickFrequency="5" Value="10" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="4" Grid.Column="2" x:Name="_tbMinimumSaturation" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="5" Grid.Column="0" Content="Hue" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="5" Grid.Column="1" x:Name="_sliderHue" Minimum="-180" Maximum="180" TickFrequency="15" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="5" Grid.Column="2" x:Name="_tbHue" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="6" Grid.Column="0" Content="Saturation" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="6" Grid.Column="1" x:Name="_sliderSaturation" Minimum="-100" Maximum="100" TickFrequency="10" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="6" Grid.Column="2" x:Name="_tbSaturation" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="7" Grid.Column="0" Content="Lightness" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="7" Grid.Column="1" x:Name="_sliderLightness" Minimum="-100" Maximum="100" TickFrequency="10" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="7" Grid.Column="2" x:Name="_tbLightness" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="8" Grid.Column="0" Content="Brightness" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="8" Grid.Column="1" x:Name="_sliderBrightness" Minimum="-100" Maximum="100" TickFrequency="10" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="8" Grid.Column="2" x:Name="_tbBrightness" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Label Grid.Row="9" Grid.Column="0" Content="Contrast" Padding="0" VerticalAlignment="Center" />
		<Slider Grid.Row="9" Grid.Column="1" x:Name="_sliderContrast" Minimum="-100" Maximum="100" TickFrequency="10" ValueChanged="_control_ValueChanged" />
		<TextBlock Grid.Row="9" Grid.Column="2" x:Name="_tbContrast" Margin="8 0 0 0" VerticalAlignment="Center" />

		<Button Grid.Row="10" Grid.Column="0" Margin="0 12 0 0" Padding="8 3" HorizontalAlignment="Left"
		        Content="Reset" Click="_buttonReset_Click" />

		<StackPanel Grid.Row="11" Grid.ColumnSpan="3" Margin="0 12 0 0" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Width="70" Margin="0 0 6 0" IsDefault="True" Content="OK" Click="_buttonOk_Click" />
			<Button Width="70" IsCancel="True" Content="Cancel" Click="_buttonCancel_Click" />
		</StackPanel>
	</Grid>
</Window>
